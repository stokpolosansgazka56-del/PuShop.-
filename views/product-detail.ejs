<% title = product.name %>
<%- include('layout', { body: `
  <div class="row">
    <div class="col-md-6">
      <img src="<%= product.image_url || '/uploads/default.jpg' %>" class="img-fluid" alt="<%= product.name %>">
    </div>
    <div class="col-md-6">
      <h1><%= product.name %></h1>
      <p class="lead"><strong>Rp <%= product.price.toLocaleString() %></strong></p>
      <p><%= product.description %></p>
      <% if (user) { %>
        <a href="/checkout/<%= product.id %>" class="btn btn-success btn-lg">Beli Sekarang</a>
      <% } else { %>
        <a href="/login" class="btn btn-secondary">Login untuk membeli</a>
      <% } %>
      <a href="/products" class="btn btn-outline-secondary mt-2">Kembali</a>
    </div>
  </div>
` }) %>